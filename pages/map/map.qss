.map-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #0d2137;
}

.webgl {
  width: 100%;
  height: 100%;
  display: block;
}

.hud {
  position: absolute;
  left: 32rpx;
  top: 24rpx;
  z-index: 2;
  pointer-events: none;
}

.hud-nick {
  display: block;
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.45);
}

.hud-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.dpad {
  position: absolute;
  right: 40rpx;
  bottom: 80rpx;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.dpad-row {
  display: flex;
  flex-direction: row;
  justify-content: center;
  margin-top: 12rpx;
}

.key {
  width: 96rpx;
  height: 96rpx;
  margin: 0 10rpx;
  border-radius: 16rpx;
  background: rgba(18, 183, 245, 0.55);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  user-select: none;
}
