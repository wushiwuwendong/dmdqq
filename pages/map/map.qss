page {
  background: #87b7d9;
  overflow: hidden;
}

.map-page {
  position: relative;
  overflow: hidden;
  background: #87b7d9;
}

.map-canvas {
  display: block;
  position: absolute;
  left: 0;
  top: 0;
  z-index: 1;
}

.hud {
  position: absolute;
  left: 16px;
  top: 12px;
  z-index: 10;
  pointer-events: none;
}

.hud-nick {
  color: #ffffff;
  font-size: 16px;
  font-weight: bold;
}

.hud-hint {
  margin-top: 4px;
  color: #f0f6ff;
  font-size: 12px;
}

.dpad {
  position: absolute;
  right: 20px;
  bottom: 40px;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.dpad-row {
  display: flex;
  flex-direction: row;
  justify-content: center;
  margin-top: 6px;
}

.key {
  width: 52px;
  height: 52px;
  margin: 0 5px;
  border-radius: 8px;
  background-color: rgba(18, 183, 245, 0.75);
  color: #ffffff;
  font-size: 15px;
  text-align: center;
  line-height: 52px;
}
