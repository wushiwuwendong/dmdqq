.page {
  min-height: 100vh;
  padding: 80rpx 48rpx 64rpx;
  box-sizing: border-box;
  background: linear-gradient(165deg, #1a3a5c 0%, #0d2137 45%, #12263a 100%);
}

.hero {
  margin-bottom: 72rpx;
}

.brand {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: #f2f6fb;
  letter-spacing: 4rpx;
}

.sub {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  color: rgba(242, 246, 251, 0.65);
}

.card {
  padding: 48rpx 40rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  margin-bottom: 24rpx;
  background: #2a4a6a;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar.placeholder {
  background: #12b7f5;
}

.avatar-letter {
  color: #fff;
  font-size: 48rpx;
  font-weight: 700;
}

.nick {
  font-size: 36rpx;
  color: #fff;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.tip {
  font-size: 26rpx;
  color: rgba(242, 246, 251, 0.7);
  text-align: center;
  line-height: 1.5;
  margin-bottom: 40rpx;
}

.btn {
  width: 100%;
  margin: 0 0 20rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.btn.primary {
  background: #12b7f5;
  color: #fff;
}

.btn.ghost {
  background: transparent;
  color: rgba(242, 246, 251, 0.85);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
}

.btn::after {
  border: none;
}
